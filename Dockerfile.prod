# Dockerfile.prod - immagine di produzione per il backend Django
FROM python:3.11-alpine

WORKDIR /usr/src/app

COPY requirements.txt .

RUN pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN python manage.py collectstatic --noinput

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget --spider -q http://127.0.0.1:8000/admin/login/ || exit 1

CMD ["sh", "-c", "python manage.py migrate && gunicorn CompanyResources.wsgi:application --bind 0.0.0.0:8000 --workers 3"]
